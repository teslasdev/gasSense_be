generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "mysql"
 url = env("DATABASE_URL")
}
enum MembershipRole {
 OWNER
 MEMBER
}
enum DeviceStatus {
 PENDING
 ONLINE
 OFFLINE
 REVOKED
}
enum GasValveState {
  UNKNOWN
  OPEN
  CLOSED
}
enum ReadingQuality {
 VALID
 UNSTABLE
 IMPLAUSIBLE
 SENSOR_FAULT
}
enum NotificationKind {
 LOW_GAS
 DEVICE_OFFLINE
 REFILL_SUSPECTED
 SENSOR_FAULT
}
enum NotificationStatus {
 UNREAD
 READ
}
enum DeliveryStatus {
 PENDING
 SENT
 FAILED
 SKIPPED
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 name String
 createdAt DateTime @default(now())
 memberships Membership[]
 sessions Session[]
 notifications Notification[]
}
model Session {
 id String @id
 userId String
 user User @relation(fields:[userId], references:[id], onDelete: Cascade)
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([userId])
}
model Household {
 id String @id @default(cuid())
 name String
 timezone String @default("Africa/Lagos")
 createdAt DateTime @default(now())
 memberships Membership[]
 devices Device[]
 cylinders CylinderConfiguration[]
 readings Reading[]
 refills RefillEvent[]
 alertPreferences AlertPreference[]
}
model Membership {
 id String @id @default(cuid())
 householdId String
 userId String
 role MembershipRole @default(MEMBER)
 household Household @relation(fields:[householdId], references:[id], onDelete: Cascade)
 user User @relation(fields:[userId], references:[id], onDelete: Cascade)
 @@unique([householdId,userId])
 @@index([userId])
}
model Device {
 id String @id @default(cuid())
  sensorId String? @unique
 householdId String
 name String
 status DeviceStatus @default(PENDING)
 lastSeenAt DateTime?
 firmwareVersion String?
 batteryLevel Int?
  gasValveState GasValveState @default(UNKNOWN)
 controlCommand String?
 controlUpdatedAt DateTime?
 simulationState String? @default("running")
 household Household @relation(fields:[householdId], references:[id], onDelete: Cascade)
 credentials DeviceCredential[]
 pairingCodes PairingCode[]
 readings Reading[]
 cylinder CylinderConfiguration?
 createdAt DateTime @default(now())
 @@index([householdId,status])
}
model DeviceCredential {
 id String @id @default(cuid())
 deviceId String
 label String
 hash String
 lastUsedAt DateTime?
 revokedAt DateTime?
 createdAt DateTime @default(now())
 device Device @relation(fields:[deviceId], references:[id], onDelete: Cascade)
 @@index([deviceId,revokedAt])
}
model PairingCode {
 id String @id @default(cuid())
 deviceId String
 codeHash String
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 device Device @relation(fields:[deviceId], references:[id], onDelete: Cascade)
 @@index([codeHash,expiresAt])
}
model CylinderConfiguration {
 id String @id @default(cuid())
 householdId String
 deviceId String @unique
 tareGrams Int
 capacityGrams Int
 accessoryGrams Int @default(0)
 effectiveFrom DateTime @default(now())
 effectiveTo DateTime?
 household Household @relation(fields:[householdId], references:[id], onDelete: Cascade)
 device Device @relation(fields:[deviceId], references:[id], onDelete: Cascade)
 @@index([householdId,effectiveFrom])
}
model Reading {
 id String @id @default(cuid())
 deviceId String
 householdId String
 readingId String
 bootId String
 sequence Int
 capturedAt DateTime
 receivedAt DateTime @default(now())
 grossWeightGrams Int
 stable Boolean
 firmwareVersion String?
 quality ReadingQuality @default(VALID)
 batteryLevel Int?
 gasRemainingGrams Int?
 simulatorState String?
 device Device @relation(fields:[deviceId], references:[id], onDelete: Cascade)
 household Household @relation(fields:[householdId], references:[id], onDelete: Cascade)
 @@unique([deviceId,readingId])
 @@index([deviceId,capturedAt])
 @@index([householdId,receivedAt])
}
model RefillEvent {
 id String @id @default(cuid())
 householdId String
 deviceId String
 readingId String?
 confirmed Boolean @default(false)
 detectedAt DateTime @default(now())
 notes String?
 household Household @relation(fields:[householdId], references:[id], onDelete: Cascade)
 @@index([householdId,detectedAt])
}
model AlertPreference {
 id String @id @default(cuid())
 householdId String
 lowGasPercent Int @default(20)
 offlineMinutes Int @default(30)
 enabled Boolean @default(true)
 household Household @relation(fields:[householdId], references:[id], onDelete: Cascade)
 @@unique([householdId])
}
model Notification {
 id String @id @default(cuid())
 userId String
 householdId String
 deviceId String?
 kind NotificationKind
 status NotificationStatus @default(UNREAD)
 title String
 body String
 dedupeKey String
 createdAt DateTime @default(now())
 readAt DateTime?
 user User @relation(fields:[userId], references:[id], onDelete: Cascade)
 attempts NotificationDeliveryAttempt[]
 @@unique([householdId,dedupeKey])
 @@index([userId,status,createdAt])
}
model NotificationDeliveryAttempt {
 id String @id @default(cuid())
 notificationId String
 channel String
 status DeliveryStatus @default(PENDING)
 attemptedAt DateTime @default(now())
 providerMessage String?
 notification Notification @relation(fields:[notificationId], references:[id], onDelete: Cascade)
 @@index([notificationId,channel])
}
