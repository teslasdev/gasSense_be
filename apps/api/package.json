  },
  "devDependencies": { "@types/bcryptjs": "^2.4.6", "@types/cookie-parser": "^1.4.8", "@types/cors": "^2.8.17", "@types/express": "^5.0.1", "@types/node": "^22.15.3", "prisma": "^6.7.0", "tsx": "^4.19.3", "typescript": "^5.8.3" }
